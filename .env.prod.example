# Variables que docker-compose.prod.yml sustituye en el servicio "db"
# (docker compose las carga automaticamente desde un archivo ".env" en el
# mismo directorio del compose). En el servidor: copiar este archivo como
# ".env" (sin ".example") y poner credenciales reales generadas para ese
# despliegue -- NUNCA reutilizar valores de este ejemplo ni comitear el
# ".env" resultante (ya esta cubierto por .gitignore: ".env" + ".env.*").
#
# Estos mismos valores de POSTGRES_USER/POSTGRES_PASSWORD/POSTGRES_DB deben
# coincidir exactamente con los que se usen en backend/.env.prod (POSTGRES_*)
# para que el backend pueda conectarse al contenedor "db".
POSTGRES_USER=refrigerados_prod
POSTGRES_PASSWORD=CAMBIAR_POR_UNA_CLAVE_GENERADA
POSTGRES_DB=refrigerados_prod
