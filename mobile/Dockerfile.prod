# Sirve la versión WEB de la app Expo (útil para probar/usar desde el
# navegador en el servidor). El APK de Android se genera aparte con
# `npx expo run:android` o EAS Build — eso NO corre dentro de este
# contenedor, Docker no puede instalar apps en el celular del cliente.
FROM node:20 AS builder
WORKDIR /app
COPY package*.json ./
RUN npm install --legacy-peer-deps
COPY . .
ARG EXPO_PUBLIC_API_URL
ENV EXPO_PUBLIC_API_URL=$EXPO_PUBLIC_API_URL
RUN npx expo export --platform web

FROM nginx:alpine
COPY --from=builder /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
